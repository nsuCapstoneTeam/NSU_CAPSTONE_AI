# NSU_CAPSTONE/backend/.env의 PostgreSQL 설정과 맞춘다. 실제 secret은 commit하지 않는다.
# Windows Docker Desktop -> Backend DB의 host 공개 port.
# Local Python: localhost / same Docker network: postgres / Production: RDS endpoint.
DB_HOST=host.docker.internal
# Backend의 POSTGRES_PORT / POSTGRES_DB / POSTGRES_USER와 맞춘다.
DB_PORT=5432
DB_NAME=capstone_db
DB_USER=capstone
# Single quotes preserve literal characters such as $ and #.
DB_PASSWORD=''
# DB 연결 제한 시간(초).
DB_CONNECT_TIMEOUT=3
# host port (container port is always 8000).
AI_PORT=8000
# runtime Compose image. dev Compose uses a local nsu-capstone-ai:dev build.
AI_IMAGE=ghcr.io/nsucapstoneteam/nsu-capstone-ai:phase1
# HF_HOME=/var/cache/huggingface is set by Compose, backed by huggingface_cache.
# Model files are external to the image; see DEVELOPMENT_ENVIRONMENT.md.

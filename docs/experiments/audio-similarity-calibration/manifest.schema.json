{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audio Similarity Calibration Manifest",
  "description": "Calibration experiment manifest, not a production API schema. For candidate_selection_complete the integrated validator also enforces no more than two samples per credited artist (normalized by whitespace and case), in addition to unique sample and real-track identities. When a prepared segment is present, frame counts and durations must describe the exact centered 60-second extraction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_version",
    "cohort_target",
    "cohort_status",
    "segment_rule",
    "samples"
  ],
  "properties": {
    "dataset_version": {
      "type": "string",
      "const": "audio-similarity-calibration-v1"
    },
    "cohort_target": {
      "type": "integer",
      "const": 50
    },
    "cohort_status": {
      "type": "string",
      "enum": [
        "candidate_selection_incomplete",
        "candidate_selection_complete"
      ]
    },
    "segment_rule": {
      "type": "string",
      "const": "offline_calibration_decoded_audio_center_exact_60_seconds"
    },
    "samples": {
      "description": "For candidate_selection_complete, the integrated validator requires unique sample_id and source_url values, unique (provider, provider_track_id) pairs when provider_track_id is present, and at most two records for each credited artist after whitespace normalization and case folding. A missing provider_track_id relies on source_url uniqueness. A complete cohort also requires non-blank title, artist, provider, license name, license URL and source URL, an explicit attribution_required boolean, and non-blank attribution when required. Artist aliases and contributor-credit parsing remain part of the documented human review, not automatic identity resolution.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/sample"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cohort_status": {
            "const": "candidate_selection_complete"
          }
        },
        "required": [
          "cohort_status"
        ]
      },
      "then": {
        "properties": {
          "samples": {
            "type": "array",
            "minItems": 50,
            "maxItems": 50,
            "items": {
              "properties": {
                "source_catalog_duration": {
                  "type": "number",
                  "minimum": 60
                },
                "decoded_duration": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "commercial_use_status": {
                  "const": "allowed"
                },
                "rights_status": {
                  "const": "confirmed_from_official_metadata"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "artist": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "provider": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_url": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$",
                  "format": "uri"
                },
                "provider_track_id": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  ]
                },
                "license_name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "license_url": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$",
                  "format": "uri"
                },
                "attribution_required": {
                  "type": "boolean"
                }
              },
              "required": [
                "source_catalog_duration",
                "commercial_use_status",
                "rights_status",
                "title",
                "artist",
                "provider",
                "source_url",
                "license_name",
                "license_url",
                "attribution_required"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "acquisition_method": {
                        "enum": [
                          "official_direct_download",
                          "other_confirmed_method"
                        ]
                      }
                    },
                    "required": [
                      "acquisition_method"
                    ]
                  },
                  "then": {
                    "properties": {
                      "source_local_path": {
                        "$ref": "#/$defs/sourceAudioPath"
                      }
                    },
                    "required": [
                      "source_local_path",
                      "source_sha256"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "acquisition_method": {
                        "enum": [
                          "not_acquired",
                          "pending"
                        ]
                      }
                    },
                    "required": [
                      "acquisition_method"
                    ]
                  },
                  "then": {
                    "properties": {
                      "decoded_duration": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "attribution_required": {
                        "const": true
                      }
                    },
                    "required": [
                      "attribution_required"
                    ]
                  },
                  "then": {
                    "properties": {
                      "attribution": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableString": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceAudioPath": {
      "type": "string",
      "minLength": 1,
      "description": "Repository-relative POSIX path with at least a sample directory and file below data/calibration/audio/source/. JSON Schema enforces path shape and traversal safety; the semantic validator binds the first directory to the record sample_id and checks resolved containment.",
      "pattern": "^data/calibration/audio/source/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[^/\\\\]+/[^/\\\\]+(?:/[^/\\\\]+)*$"
    },
    "nullableSourceAudioPath": {
      "oneOf": [
        {"$ref": "#/$defs/sourceAudioPath"},
        {"type": "null"}
      ]
    },
    "preparedAudioPath": {
      "type": "string",
      "minLength": 1,
      "description": "Repository-relative POSIX WAV path below data/calibration/audio/prepared/. JSON Schema enforces path shape and traversal safety; the semantic validator binds the filename stem to the record sample_id and checks resolved containment.",
      "pattern": "^data/calibration/audio/prepared/(?!\\.{1,2}$)[^/\\\\]+\\.wav$"
    },
    "nullablePreparedAudioPath": {
      "oneOf": [
        {"$ref": "#/$defs/preparedAudioPath"},
        {"type": "null"}
      ]
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "nullableNonNegativeInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "nullablePositiveInteger": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "labelSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "provider",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "source_metadata"
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$",
              "format": "uri"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "annotator_id",
            "protocol_version"
          ],
          "properties": {
            "kind": {
              "const": "manual_label"
            },
            "annotator_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "protocol_version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "title",
        "artist",
        "provider",
        "provider_track_id",
        "source_url",
        "source_local_path",
        "source_sha256",
        "source_catalog_duration",
        "decoded_duration",
        "source_sample_rate",
        "source_channels",
        "source_codec",
        "license_name",
        "license_url",
        "attribution",
        "commercial_use_status",
        "attribution_required",
        "rights_status",
        "acquisition_method",
        "source_file_kind",
        "full_track_verified",
        "full_track_evidence",
        "segment_rule",
        "segment_start_frame",
        "segment_end_frame_exclusive",
        "prepared_local_path",
        "prepared_sha256",
        "prepared_duration",
        "genre_value",
        "genre_source",
        "mood_value",
        "mood_source",
        "vocal_instrumental",
        "label_status",
        "notes"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "pattern": "^cal-[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider_track_id": {
          "$ref": "#/$defs/nullableString"
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$",
          "format": "uri"
        },
        "source_local_path": {
          "$ref": "#/$defs/nullableSourceAudioPath"
        },
        "source_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_catalog_duration": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "decoded_duration": {
          "$ref": "#/$defs/nullableNumber"
        },
        "decoded_frame_count": {
          "$ref": "#/$defs/nullablePositiveInteger",
          "description": "Exact decoded source frame count; required when decoded_duration is recorded and for any prepared segment, so frame bounds and centered extraction can be validated without rounded-duration arithmetic."
        },
        "source_sample_rate": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "source_channels": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "source_file_size": {
          "$ref": "#/$defs/nullablePositiveInteger",
          "description": "Null before acquisition; a positive byte count is required from acquired state onward."
        },
        "source_codec": {
          "$ref": "#/$defs/nullableString"
        },
        "license_name": {
          "$ref": "#/$defs/nullableString"
        },
        "license_url": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "attribution": {
          "$ref": "#/$defs/nullableString"
        },
        "commercial_use_status": {
          "type": "string",
          "enum": [
            "allowed",
            "restricted",
            "unknown"
          ]
        },
        "attribution_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rights_status": {
          "type": "string",
          "enum": [
            "confirmed_from_official_metadata",
            "pending",
            "excluded"
          ]
        },
        "acquisition_method": {
          "type": "string",
          "enum": [
            "not_acquired",
            "official_direct_download",
            "other_confirmed_method",
            "pending"
          ]
        },
        "source_file_kind": {
          "type": "string",
          "enum": ["full_track", "preview", "sample", "unknown"]
        },
        "full_track_verified": {
          "type": ["boolean", "null"]
        },
        "full_track_evidence": {
          "$ref": "#/$defs/nullableString"
        },
        "segment_rule": {
          "type": "string",
          "const": "offline_calibration_decoded_audio_center_exact_60_seconds"
        },
        "segment_start_frame": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "segment_end_frame_exclusive": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "prepared_local_path": {
          "$ref": "#/$defs/nullablePreparedAudioPath"
        },
        "prepared_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "prepared_duration": {
          "$ref": "#/$defs/nullableNumber"
        },
        "genre_value": {
          "$ref": "#/$defs/nullableString"
        },
        "genre_source": {
          "$ref": "#/$defs/labelSource"
        },
        "mood_value": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "mood_source": {
          "$ref": "#/$defs/labelSource"
        },
        "vocal_instrumental": {
          "type": "string",
          "enum": [
            "vocal",
            "instrumental",
            "mixed",
            "unknown"
          ]
        },
        "label_status": {
          "type": "string",
          "enum": [
            "source_metadata_only",
            "manual_labels_pending",
            "partially_labeled",
            "reviewed",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "acquisition_method": {
                "enum": [
                  "official_direct_download",
                  "other_confirmed_method"
                ]
              }
            },
            "required": [
              "acquisition_method"
            ]
          },
          "then": {
            "required": [
              "source_local_path",
              "source_sha256",
              "source_file_size"
            ],
            "properties": {
              "source_local_path": {
                "$ref": "#/$defs/sourceAudioPath"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_file_size": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "acquisition_method": {
                "enum": ["not_acquired", "pending"]
              }
            },
            "required": [
              "acquisition_method"
            ]
          },
          "then": {
            "properties": {
              "source_sha256": {
                "type": "null"
              },
              "source_local_path": {
                "type": "null"
              },
              "source_file_size": {
                "type": "null"
              },
              "decoded_duration": {
                "type": "null"
              },
              "decoded_frame_count": {
                "type": "null"
              },
              "source_sample_rate": {
                "type": "null"
              },
              "source_channels": {
                "type": "null"
              },
              "source_codec": {
                "type": "null"
              },
              "source_file_kind": {
                "const": "unknown"
              },
              "full_track_verified": {
                "type": "null"
              },
              "full_track_evidence": {
                "type": "null"
              },
              "segment_start_frame": {
                "type": "null"
              },
              "segment_end_frame_exclusive": {
                "type": "null"
              },
              "prepared_sha256": {
                "type": "null"
              },
              "prepared_local_path": {
                "type": "null"
              },
              "prepared_duration": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decoded_duration": {
                "type": "number"
              }
            },
            "required": [
              "decoded_duration"
            ]
          },
          "then": {
            "required": [
              "decoded_frame_count",
              "source_sample_rate",
              "source_channels"
            ],
            "properties": {
              "decoded_frame_count": {
                "type": "integer",
                "minimum": 1
              },
              "source_sample_rate": {
                "type": "integer",
                "minimum": 1
              },
              "source_channels": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decoded_frame_count": {
                "type": "integer"
              }
            },
            "required": [
              "decoded_frame_count"
            ]
          },
          "then": {
            "required": [
              "decoded_duration",
              "source_sample_rate",
              "source_channels"
            ],
            "properties": {
              "decoded_duration": {
                "type": "number",
                "minimum": 0
              },
              "source_sample_rate": {
                "type": "integer",
                "minimum": 1
              },
              "source_channels": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "prepared_local_path": {
                    "type": "string"
                  }
                }
              },
              {
                "properties": {
                  "prepared_sha256": {
                    "type": "string"
                  }
                }
              },
              {
                "properties": {
                  "prepared_duration": {
                    "type": "number"
                  }
                }
              },
              {
                "properties": {
                  "segment_start_frame": {
                    "type": "integer"
                  }
                }
              },
              {
                "properties": {
                  "segment_end_frame_exclusive": {
                    "type": "integer"
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "acquisition_method",
              "source_local_path",
              "source_sha256",
              "source_file_size",
              "decoded_duration",
              "decoded_frame_count",
              "source_sample_rate",
              "source_channels",
              "segment_start_frame",
              "segment_end_frame_exclusive",
              "prepared_local_path",
              "prepared_sha256",
              "prepared_duration",
              "source_file_kind",
              "full_track_verified",
              "full_track_evidence"
            ],
            "properties": {
              "acquisition_method": {
                "enum": [
                  "official_direct_download",
                  "other_confirmed_method"
                ]
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_local_path": {
                "$ref": "#/$defs/sourceAudioPath"
              },
              "source_file_size": {
                "type": "integer",
                "minimum": 1
              },
              "source_file_kind": {
                "const": "full_track"
              },
              "full_track_verified": {
                "const": true
              },
              "full_track_evidence": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "decoded_duration": {
                "type": "number",
                "minimum": 60
              },
              "decoded_frame_count": {
                "type": "integer",
                "minimum": 1
              },
              "source_sample_rate": {
                "type": "integer",
                "minimum": 1
              },
              "source_channels": {
                "type": "integer",
                "minimum": 1
              },
              "segment_start_frame": {
                "type": "integer",
                "minimum": 0
              },
              "segment_end_frame_exclusive": {
                "type": "integer",
                "minimum": 1
              },
              "prepared_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "prepared_local_path": {
                "$ref": "#/$defs/preparedAudioPath"
              },
              "prepared_duration": {
                "const": 60
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_file_kind": {"enum": ["preview", "sample", "unknown"]}
            },
            "required": ["source_file_kind"]
          },
          "then": {
            "properties": {
              "full_track_verified": {"not": {"const": true}},
              "prepared_local_path": {"type": "null"},
              "prepared_sha256": {"type": "null"},
              "prepared_duration": {"type": "null"},
              "segment_start_frame": {"type": "null"},
              "segment_end_frame_exclusive": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"full_track_verified": {"const": true}},
            "required": ["full_track_verified"]
          },
          "then": {
            "required": [
              "acquisition_method",
              "source_local_path",
              "source_sha256",
              "source_file_size",
              "decoded_duration",
              "decoded_frame_count",
              "source_sample_rate",
              "source_channels",
              "source_file_kind",
              "full_track_evidence"
            ],
            "properties": {
              "acquisition_method": {
                "enum": ["official_direct_download", "other_confirmed_method"]
              },
              "source_local_path": {"$ref": "#/$defs/sourceAudioPath"},
              "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "source_file_size": {"type": "integer", "minimum": 1},
              "decoded_duration": {"type": "number", "minimum": 60},
              "decoded_frame_count": {"type": "integer", "minimum": 1},
              "source_sample_rate": {"type": "integer", "minimum": 1},
              "source_channels": {"type": "integer", "minimum": 1},
              "source_file_kind": {"const": "full_track"},
              "full_track_evidence": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audio Similarity Calibration Manifest",
  "description": "Calibration experiment manifest. JSON Schema checks per-sample eligibility, complete-cohort size, and license/attribution evidence shape; the integrated validator additionally enforces cross-record sample and real-track identity uniqueness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_version",
    "cohort_target",
    "cohort_status",
    "segment_rule",
    "samples"
  ],
  "properties": {
    "dataset_version": {
      "type": "string",
      "const": "audio-similarity-calibration-v1"
    },
    "cohort_target": {
      "type": "integer",
      "const": 50
    },
    "cohort_status": {
      "type": "string",
      "enum": [
        "candidate_selection_incomplete",
        "candidate_selection_complete"
      ]
    },
    "segment_rule": {
      "type": "string",
      "const": "offline_calibration_decoded_audio_center_exact_60_seconds"
    },
    "samples": {
      "description": "For candidate_selection_complete, the integrated validator requires unique sample_id and source_url values plus unique (provider, provider_track_id) pairs when provider_track_id is present. A missing provider_track_id relies on source_url uniqueness. A complete cohort also requires non-blank title, artist, provider, license name, license URL and source URL, an explicit attribution_required boolean, and non-blank attribution when required.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/sample"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cohort_status": {
            "const": "candidate_selection_complete"
          }
        },
        "required": [
          "cohort_status"
        ]
      },
      "then": {
        "properties": {
          "samples": {
            "type": "array",
            "minItems": 50,
            "maxItems": 50,
            "items": {
              "properties": {
                "source_catalog_duration": {
                  "type": "number",
                  "minimum": 60
                },
                "decoded_duration": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "commercial_use_status": {
                  "const": "allowed"
                },
                "rights_status": {
                  "const": "confirmed_from_official_metadata"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "artist": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "provider": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_url": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "format": "uri"
                },
                "provider_track_id": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  ]
                },
                "license_name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "license_url": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "format": "uri"
                },
                "attribution_required": {
                  "type": "boolean"
                }
              },
              "required": [
                "source_catalog_duration",
                "commercial_use_status",
                "rights_status",
                "title",
                "artist",
                "provider",
                "source_url",
                "license_name",
                "license_url",
                "attribution_required"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "acquisition_method": {
                        "enum": [
                          "official_direct_download",
                          "other_confirmed_method"
                        ]
                      }
                    },
                    "required": [
                      "acquisition_method"
                    ]
                  },
                  "then": {
                    "properties": {
                      "decoded_duration": {
                        "type": "number",
                        "minimum": 60
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "acquisition_method": {
                        "enum": [
                          "not_acquired",
                          "pending"
                        ]
                      }
                    },
                    "required": [
                      "acquisition_method"
                    ]
                  },
                  "then": {
                    "properties": {
                      "decoded_duration": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "attribution_required": {
                        "const": true
                      }
                    },
                    "required": [
                      "attribution_required"
                    ]
                  },
                  "then": {
                    "properties": {
                      "attribution": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableString": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "nullableNonNegativeInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "labelSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "provider",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "source_metadata"
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "format": "uri"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "annotator_id",
            "protocol_version"
          ],
          "properties": {
            "kind": {
              "const": "manual_label"
            },
            "annotator_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "protocol_version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "title",
        "artist",
        "provider",
        "provider_track_id",
        "source_url",
        "source_sha256",
        "source_catalog_duration",
        "decoded_duration",
        "source_sample_rate",
        "source_channels",
        "source_codec",
        "license_name",
        "license_url",
        "attribution",
        "commercial_use_status",
        "attribution_required",
        "rights_status",
        "acquisition_method",
        "segment_rule",
        "segment_start_frame",
        "segment_end_frame_exclusive",
        "prepared_sha256",
        "prepared_duration",
        "genre_value",
        "genre_source",
        "mood_value",
        "mood_source",
        "vocal_instrumental",
        "label_status",
        "notes"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "pattern": "^cal-[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider_track_id": {
          "$ref": "#/$defs/nullableString"
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "format": "uri"
        },
        "source_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_catalog_duration": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "decoded_duration": {
          "$ref": "#/$defs/nullableNumber"
        },
        "source_sample_rate": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "source_channels": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "source_codec": {
          "$ref": "#/$defs/nullableString"
        },
        "license_name": {
          "$ref": "#/$defs/nullableString"
        },
        "license_url": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "attribution": {
          "$ref": "#/$defs/nullableString"
        },
        "commercial_use_status": {
          "type": "string",
          "enum": [
            "allowed",
            "restricted",
            "unknown"
          ]
        },
        "attribution_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rights_status": {
          "type": "string",
          "enum": [
            "confirmed_from_official_metadata",
            "pending",
            "excluded"
          ]
        },
        "acquisition_method": {
          "type": "string",
          "enum": [
            "not_acquired",
            "official_direct_download",
            "other_confirmed_method",
            "pending"
          ]
        },
        "segment_rule": {
          "type": "string",
          "const": "offline_calibration_decoded_audio_center_exact_60_seconds"
        },
        "segment_start_frame": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "segment_end_frame_exclusive": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "prepared_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "prepared_duration": {
          "$ref": "#/$defs/nullableNumber"
        },
        "genre_value": {
          "$ref": "#/$defs/nullableString"
        },
        "genre_source": {
          "$ref": "#/$defs/labelSource"
        },
        "mood_value": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "mood_source": {
          "$ref": "#/$defs/labelSource"
        },
        "vocal_instrumental": {
          "type": "string",
          "enum": [
            "vocal",
            "instrumental",
            "mixed",
            "unknown"
          ]
        },
        "label_status": {
          "type": "string",
          "enum": [
            "source_metadata_only",
            "manual_labels_pending",
            "partially_labeled",
            "reviewed",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}

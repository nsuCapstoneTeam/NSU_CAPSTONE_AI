{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Worker Terminal",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoExit",
        "-Command",
        "Set-Location '${input:workerPath}'"
      ],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "workerPath",
      "type": "promptString",
      "description": "Worker worktree 경로"
    }
  ]
}